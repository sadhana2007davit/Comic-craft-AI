# ----------------------------------------------------------------------------
# ComicCraft settings. Copy this file to ".env" and fill in your key.
# ----------------------------------------------------------------------------

# Required. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6Luqu66VfRYU-jdCcoL0XP83xspd3ic7hb66aoaWHFG4A
# Optional. Only used when Stable Diffusion downloads its model from Hugging Face.
HF_API_KEY=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

# ---- Gemini 3.5 models ------------------------------------------------------
# Outline (fast, structured output). Works on the free tier.
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
# Story (creative writing). Works on the free tier. If the call fails the
# app automatically uses GEMINI_FLASH_MODEL instead.
GEMINI_PRO_MODEL=gemini-3.5-flash
# Illustrations with Gemini. There is no Gemini 3.5 image model, so this is
# the current Gemini image model. Needs a billing-enabled key.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ---- Illustrations ----------------------------------------------------------
# auto             = Stable Diffusion if installed, else Gemini, else title cards
# gemini           = Gemini image model
# stable_diffusion = local Stable Diffusion (pip install -r requirements-sd.txt)
# placeholder      = title cards only (instant, free)
IMAGE_BACKEND=auto
# Stable Diffusion options (only used with the stable_diffusion backend)
SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
SD_STEPS=25
SD_IMAGE_SIZE=512

# ---- Testing ----------------------------------------------------------------
# true = no AI calls at all: sample story + title cards. Lets you check the
# pages and the PDF export without an API key.
COMICCRAFT_MOCK_AI=True
